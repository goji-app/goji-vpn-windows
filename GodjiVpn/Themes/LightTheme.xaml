<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Палитра "Tactical Sand & Void" (редизайн) — 1:1 с Android GodjiColors.applyLight()
         (Color.kt): тёплый "песочный" холст с глубоким изумрудным акцентом. Была "Godji VPN v3
         Daylight" — сами имена ключей не менялись, чтобы не трогать все Views разом. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F4EFE6"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#FAF7F2"/>
    <SolidColorBrush x:Key="InkBrush" Color="#152220"/>
    <SolidColorBrush x:Key="InkShadowBrush" Color="#0B1512"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#152220"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4E5D59"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7B8A85"/>
    <SolidColorBrush x:Key="TealBrush" Color="#00875A"/>
    <SolidColorBrush x:Key="TealDeepBrush" Color="#005235"/>
    <SolidColorBrush x:Key="TealTintBrush" Color="#E3F2EA"/>
    <SolidColorBrush x:Key="TealTintBorderBrush" Color="#B8DECB"/>
    <SolidColorBrush x:Key="TerracottaBrush" Color="#D84A2A"/>
    <SolidColorBrush x:Key="TerracottaDeepBrush" Color="#8B1A00"/>
    <SolidColorBrush x:Key="TerracottaTintBrush" Color="#FBE4DC"/>
    <SolidColorBrush x:Key="TerracottaTintBorderBrush" Color="#F0C0AE"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#C9911F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D84A2A"/>
    <SolidColorBrush x:Key="JamBgBrush" Color="#FBE4DC"/>
    <SolidColorBrush x:Key="JamBorderBrush" Color="#F0C0AE"/>
    <SolidColorBrush x:Key="JamTextBrush" Color="#8B1A00"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#ECE5DA"/>
    <SolidColorBrush x:Key="CardBorderStrongBrush" Color="#E4DCC8"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D8CFB8"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#ECE5DA"/>
    <SolidColorBrush x:Key="TrackBgBrush" Color="#ECE5DA"/>
    <SolidColorBrush x:Key="BorderTealBrush" Color="#2600875A"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#00838F"/>

    <!-- Совместимость со старыми именами ресурсов из MVP-каркаса (первый проход) —
         переиспользуют новую палитру один в один, чтобы не переписывать все Views разом. -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#ECE5DA"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#00875A"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#005235"/>
    <SolidColorBrush x:Key="TextBrush" Color="#152220"/>

</ResourceDictionary>

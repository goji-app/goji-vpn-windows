<UserControl x:Class="GodjiVpn.Controls.DaysRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="70" Height="70">
    <Grid>
        <Ellipse Stroke="{DynamicResource TrackBgBrush}" StrokeThickness="8" Margin="4"/>
        <Path x:Name="ArcPath" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#076A62" Offset="0"/>
                    <GradientStop Color="#00A79B" Offset="1"/>
                </LinearGradientBrush>
            </Path.Stroke>
        </Path>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="DaysText" FontFamily="{StaticResource ManropeExtraBoldFamily}" FontSize="19"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="ДНЕЙ" FontFamily="{StaticResource ManropeSemiBoldFamily}" FontSize="7.5"
                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>

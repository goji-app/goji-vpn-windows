<UserControl x:Class="GodjiVpn.Views.PlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GodjiVpn.Controls">
    <Grid Background="{DynamicResource BgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,18,18,10">
            <StackPanel>

                <!-- Заголовок -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Твоя подписка" Style="{StaticResource Headline}" FontSize="26"/>
                        <TextBlock Text="Продлевается вручную — списаний врасплох не будет"
                                   FontFamily="{StaticResource ManropeMediumFamily}" FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding CustomerId, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="ID: "/><Run Text="{Binding CustomerId, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="⧉" Style="{StaticResource LinkButton}" Padding="6,0" FontSize="11"
                                    Command="{Binding CopyCustomerIdCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="8" VerticalAlignment="Top"
                            Command="{Binding RefreshCommand}" Content="⟳" FontSize="14"/>
                </Grid>

                <!-- Текущий тариф -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1.5" CornerRadius="20" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:DaysRing Days="{Binding DaysLeft}" Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="13.5">
                                    <Run Text="Ваш тариф: "/><Run Text="{Binding PlanName, Mode=OneWay}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Margin="0,3,0,4" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="До "/><Run Text="{Binding ExpiryLabel, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Margin="0,0,0,8" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="Устройств по тарифу: "/><Run Text="{Binding DeviceLimit, Mode=OneWay}" FontWeight="Bold"/>
                                </TextBlock>
                                <Border Background="{DynamicResource TealTintBrush}" CornerRadius="20" Padding="8,3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource TealBrush}" Tag="pulse" Style="{StaticResource PulseDot}" VerticalAlignment="Center"/>
                                        <TextBlock Text="АКТИВНА" FontFamily="{StaticResource ManropeExtraBoldFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TealDeepBrush}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Button Content="Продлить" Style="{StaticResource InkButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Stretch" Command="{Binding OpenRenewCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Период -->
                <Border Background="{DynamicResource ChipBrush}" CornerRadius="16" Padding="5" Margin="0,0,0,14"
                        Visibility="{Binding Periods.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Periods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Margin="2" Padding="0"
                                        Command="{Binding DataContext.SelectPeriodCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Months}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PressScaleButtonBase}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Список тарифов (информационно) -->
                <ItemsControl ItemsSource="{Binding Plans}" Margin="0,0,0,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="18" Padding="14" Margin="0,0,0,8" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource TealTintBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource ManropeSemiBoldFamily}" FontSize="13.5"/>
                                        <TextBlock Text="{Binding Description}" FontFamily="{StaticResource ManropeMediumFamily}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,8,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PriceLabel}" FontFamily="{StaticResource ManropeExtraBoldFamily}"
                                               FontSize="16" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Поддержка -->
                <Border Background="{DynamicResource TerracottaTintBrush}" BorderBrush="{DynamicResource TerracottaTintBorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,14"
                        Style="{StaticResource PressScaleBorder}" MouseLeftButtonUp="OnSupportClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✉️" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Остались проблемы или что-то не работает? Напиши в поддержку."
                                   Foreground="{DynamicResource TerracottaDeepBrush}" FontFamily="{StaticResource ManropeMediumFamily}"
                                   FontSize="12" TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

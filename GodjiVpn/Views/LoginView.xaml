<UserControl x:Class="GodjiVpn.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GodjiVpn.Controls">
    <Grid Background="{DynamicResource BgBrush}">

        <!-- Глобус на весь фон, приглушённый градиентом снизу — как на Android LoginScreen.
             Работает поверх WPF-контента только благодаря WebView2CompositionControl внутри
             GlobeHost (обычный WebView2 рисуется как нативное окно и перекрыл бы всё). -->
        <controls:GlobeHost x:Name="Globe"/>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00EFE9DA" Offset="0"/>
                    <GradientStop Color="#00EFE9DA" Offset="0.5"/>
                    <GradientStop Color="#EFE9DA" Offset="0.82"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Заголовок -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,18,0,0">
            <Image Source="pack://application:,,,/Assets/Images/logo.png" Width="26" Height="26"/>
            <TextBlock Text="Goji" FontFamily="{StaticResource ManropeExtraBoldFamily}" FontSize="17" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Форма, прижата к низу -->
        <ScrollViewer VerticalAlignment="Bottom" VerticalScrollBarVisibility="Auto" MaxHeight="560">
            <StackPanel Margin="20,0,20,16">

                <TextBlock Text="Привет. Куда&#10;подключаемся сегодня?" Style="{StaticResource Headline}" FontSize="30" Margin="0,0,0,14"/>

                <!-- "Впервые здесь?" -->
                <Border Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1"
                        CornerRadius="24" Padding="12" Margin="0,0,0,14" Style="{StaticResource PressScaleBorder}"
                        MouseLeftButtonUp="OnBotBannerClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="✈️" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0">
                            <TextBlock Text="Впервые здесь?" FontFamily="{StaticResource ManropeExtraBoldFamily}" FontSize="12.5"/>
                            <TextBlock Text="Сначала откройте бота в Telegram — там вы подтвердите, что не робот, и получите рабочий пробный период."
                                       FontFamily="{StaticResource ManropeMediumFamily}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>
                </Border>

                <!-- Вход через сайт — раньше здесь были отдельные кнопки Google/Telegram/Yandex,
                     но нативный обмен кода на токен (api/auth/native/exchange) сломан на бэкенде
                     7.1.0 для всех провайдеров без исключения. Все три вели бы в одно и то же
                     место — полноценный веб-вход сайта во встроенном окне (см.
                     LoginViewModel.OpenWebLoginAsync/Views/WebLoginWindow), где пользователь сам
                     выбирает провайдера, — поэтому оставили одну кнопку, как и в Android-версии. -->
                <StackPanel Visibility="{Binding EmailMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Button Content="Продолжить через сайт" Style="{StaticResource InkButton}" Height="54"
                            Command="{Binding OpenWebLoginCommand}" Margin="0,0,0,10"/>

                    <Button Content="Через email и код из письма" Style="{StaticResource LinkButton}" Command="{Binding ShowEmailFormCommand}"/>
                </StackPanel>

                <!-- Email-вход -->
                <StackPanel Visibility="{Binding EmailMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Email" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding OtpSent, Converter={StaticResource InverseBoolConverter}}" Margin="0,0,0,10"/>

                    <StackPanel Visibility="{Binding OtpSent, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Код из письма" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    </StackPanel>

                    <Button Content="{Binding SendOtpButtonText}" Style="{StaticResource PrimaryButton}" Height="54"
                            Command="{Binding SendOtpCommand}" Margin="0,0,0,8"
                            Visibility="{Binding OtpSent, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <Button Content="Войти" Style="{StaticResource PrimaryButton}" Height="54"
                            Command="{Binding VerifyCommand}" Margin="0,0,0,8"
                            Visibility="{Binding OtpSent, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Content="← Другие способы входа" Style="{StaticResource LinkButton}" Command="{Binding ShowOAuthOptionsCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource TealDeepBrush}" FontSize="12"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,0"
                           Visibility="{Binding InfoMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                <TextBlock Text="Аккаунта нет? Создадим сами, ничего заполнять не нужно." FontFamily="{StaticResource ManropeMediumFamily}"
                           FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,6"/>

                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontFamily="{StaticResource ManropeMediumFamily}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="Создавая аккаунт, вы соглашаетесь с "/>
                    <Hyperlink Foreground="{DynamicResource TealDeepBrush}" Click="OnTermsClick"><Run Text="пользовательским соглашением" FontFamily="{StaticResource ManropeSemiBoldFamily}"/></Hyperlink>
                    <Run Text=" и "/>
                    <Hyperlink Foreground="{DynamicResource TealDeepBrush}" Click="OnPrivacyClick"><Run Text="политикой конфиденциальности" FontFamily="{StaticResource ManropeSemiBoldFamily}"/></Hyperlink>
                    <Run Text="."/>
                </TextBlock>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

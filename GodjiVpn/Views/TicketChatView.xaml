<UserControl x:Class="GodjiVpn.Views.TicketChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="‹" FontSize="22" Padding="0,0,10,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Foreground="{DynamicResource TextPrimaryBrush}" Command="{Binding BackCommand}"/>
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontFamily="{StaticResource ManropeSemiBoldFamily}"
                       FontSize="15" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Grid Grid.Row="1">
            <ProgressBar Width="26" Height="26" IsIndeterminate="True" Foreground="{DynamicResource TealDeepBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding Loading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding LoadError, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Не удалось загрузить переписку" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,0,0,8"/>
                <Button Content="Повторить" Style="{StaticResource SecondaryButton}" Padding="14,7" Command="{Binding RetryCommand}"/>
            </StackPanel>

            <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="14,0,14,10"
                          Visibility="{Binding Loading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6,0,0">

                                <!-- Системное событие ленты ("тикет создан/назначен/закрыт") — по центру,
                                     без баббла, как в Android (IsEvent). -->
                                <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4"
                                           Visibility="{Binding IsEvent, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <Border MaxWidth="280" Padding="12,9" CornerRadius="16"
                                        Visibility="{Binding IsEvent, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SenderName}" FontSize="10.5" FontFamily="{StaticResource ManropeSemiBoldFamily}"
                                                   Foreground="{DynamicResource TealDeepBrush}" Margin="0,0,0,3"
                                                   Visibility="{Binding HasSenderName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding AttachmentNames}" Margin="0,4,0,0"
                                                      Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="11" Opacity="0.85">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsMine, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="📎 "/><Run Text="{Binding}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding TimeLabel}" FontSize="9.5" Opacity="0.7" Margin="0,5,0,0"
                                                   Visibility="{Binding TimeLabel, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Обращение закрыто — панель ввода скрыта целиком, как в Android. -->
        <TextBlock Grid.Row="2" Text="Обращение закрыто" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,16"
                   Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Grid.Row="2" Margin="14,0,14,14"
                    Visibility="{Binding IsClosed, Converter={StaticResource InverseBoolToVisibilityConverter}}">

            <TextBlock Text="Не удалось отправить сообщение" FontSize="11" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,6"
                       Visibility="{Binding SendError, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Категории журнала — те же 4 файла, что в Настройках → Журнал (см.
                 SettingsViewModel.LogFiles); текст вставляется прямо в поле ввода, не как
                 вложение (см. TicketChatViewModel.InsertLog — бэкенд отвечает 415 на файлы,
                 отличные от image/video/PDF). -->
            <Border Background="{DynamicResource ChipBrush}" CornerRadius="14" Padding="5" Margin="0,0,0,8"
                    Visibility="{Binding ShowLogPicker, Converter={StaticResource BoolToVisibilityConverter}}">
                <WrapPanel>
                    <Button Content="Приложение" Style="{StaticResource SecondaryButton}" FontSize="10.5" Padding="8,6" Margin="2"
                            Command="{Binding InsertLogCommand}" CommandParameter="engine.log"/>
                    <Button Content="VPN-ядро" Style="{StaticResource SecondaryButton}" FontSize="10.5" Padding="8,6" Margin="2"
                            Command="{Binding InsertLogCommand}" CommandParameter="xray.log"/>
                    <Button Content="VPN-туннель" Style="{StaticResource SecondaryButton}" FontSize="10.5" Padding="8,6" Margin="2"
                            Command="{Binding InsertLogCommand}" CommandParameter="sing-box.log"/>
                    <Button Content="Сбои" Style="{StaticResource SecondaryButton}" FontSize="10.5" Padding="8,6" Margin="2"
                            Command="{Binding InsertLogCommand}" CommandParameter="crash.log"/>
                </WrapPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,6"
                          Visibility="{Binding Attachments.Count, Converter={StaticResource InverseZeroToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="12" Padding="8,5" Margin="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FileName}" FontSize="10.5" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Content="✕" Style="{StaticResource LinkButton}" FontSize="10" Padding="6,0,0,0"
                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="📷" Style="{StaticResource LinkButton}" FontSize="16" Padding="6,0"
                        ToolTip="Фото/видео" Command="{Binding PickMediaCommand}"/>
                <Button Grid.Column="1" Content="📄" Style="{StaticResource LinkButton}" FontSize="16" Padding="6,0"
                        ToolTip="PDF-файл" Command="{Binding PickPdfCommand}"/>
                <Button Grid.Column="2" Content="📋" Style="{StaticResource LinkButton}" FontSize="16" Padding="6,0"
                        ToolTip="Логи приложения" Command="{Binding ToggleLogPickerCommand}"/>

                <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="10,2" Margin="4,0" MaxHeight="90">
                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" FontSize="13" TextWrapping="Wrap"
                             AcceptsReturn="True" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto"
                             MinHeight="30"/>
                </Border>

                <Button Grid.Column="4" Content="➤" Style="{StaticResource PrimaryButton}" FontSize="14" Padding="12,8"
                        Command="{Binding SendCommand}"
                        Visibility="{Binding Sending, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <ProgressBar Grid.Column="4" Width="20" Height="20" IsIndeterminate="True" Foreground="{DynamicResource TealDeepBrush}"
                             VerticalAlignment="Center"
                             Visibility="{Binding Sending, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>

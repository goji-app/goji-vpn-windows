<UserControl x:Class="GodjiVpn.Views.FaqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="‹" FontSize="22" Padding="0,0,10,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Foreground="{DynamicResource TextPrimaryBrush}" Command="{Binding BackCommand}"/>
            <TextBlock Grid.Column="1" Text="Частые вопросы" FontFamily="{StaticResource ManropeSemiBoldFamily}"
                       FontSize="15" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,14">
            <StackPanel>

                <ProgressBar Width="26" Height="26" IsIndeterminate="True" Foreground="{DynamicResource TealDeepBrush}"
                             HorizontalAlignment="Center" Margin="0,24,0,0"
                             Visibility="{Binding Loading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <StackPanel HorizontalAlignment="Center" Margin="0,24,0,0"
                            Visibility="{Binding LoadError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Не удалось загрузить вопросы" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,0,0,8"/>
                    <Button Content="Повторить" Style="{StaticResource SecondaryButton}" Padding="14,7" Command="{Binding RetryCommand}"/>
                </StackPanel>

                <TextBlock Text="Пока нет вопросов" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"
                           HorizontalAlignment="Center" Margin="0,24,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource SpaceGroteskFamily}" FontWeight="Medium"
                                           FontSize="16" Margin="0,0,0,8"
                                           Visibility="{Binding HasName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,8"
                                                    Style="{StaticResource PressScaleBorder}"
                                                    MouseLeftButtonUp="OnQuestionClick" Tag="{Binding}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Question}" FontFamily="{StaticResource ManropeSemiBoldFamily}"
                                                                   FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" FontSize="16" Foreground="{DynamicResource TextMutedBrush}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="+"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Text" Value="−"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Answer}" FontSize="12.5" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"
                                                               Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

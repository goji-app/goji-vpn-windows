<UserControl x:Class="GodjiVpn.Views.SupportListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="18,16,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Поддержка" Style="{StaticResource Headline}" FontSize="24"/>
            <Button Grid.Column="1" Content="✕" Style="{StaticResource LinkButton}" FontSize="16" Padding="6"
                    Click="OnCloseClick"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,14">
            <StackPanel>

                <Button Content="Новое обращение" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                        HorizontalAlignment="Stretch" Command="{Binding NewTicketCommand}"/>
                <Button Content="Часто задаваемые вопросы" Style="{StaticResource LinkButton}" Margin="0,0,0,14"
                        Command="{Binding OpenFaqCommand}"/>

                <Border Background="{DynamicResource ChipBrush}" CornerRadius="16" Padding="5" Margin="0,0,0,14">
                    <UniformGrid Rows="1" Columns="2">
                        <Button Margin="2" Padding="0,8" Command="{Binding SelectTabCommand}" CommandParameter="open">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PressScaleButtonBase}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tab}" Value="0">
                                            <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Открытые" FontSize="12" FontFamily="{StaticResource ManropeSemiBoldFamily}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tab}" Value="0">
                                                <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Margin="2" Padding="0,8" Command="{Binding SelectTabCommand}" CommandParameter="closed">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PressScaleButtonBase}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tab}" Value="1">
                                            <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="История" FontSize="12" FontFamily="{StaticResource ManropeSemiBoldFamily}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tab}" Value="1">
                                                <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </UniformGrid>
                </Border>

                <ProgressBar Width="26" Height="26" IsIndeterminate="True" Foreground="{DynamicResource TealDeepBrush}"
                             HorizontalAlignment="Center" Margin="0,24,0,0"
                             Visibility="{Binding Loading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <StackPanel HorizontalAlignment="Center" Margin="0,24,0,0"
                            Visibility="{Binding LoadError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Не удалось загрузить обращения" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,0,0,8"/>
                    <Button Content="Повторить" Style="{StaticResource SecondaryButton}" Padding="14,7" Command="{Binding RetryCommand}"/>
                </StackPanel>

                <TextBlock Text="Обращений пока нет" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"
                           HorizontalAlignment="Center" Margin="0,24,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Loading}" Value="False"/>
                                        <Condition Binding="{Binding LoadError}" Value="False"/>
                                        <Condition Binding="{Binding Tickets.Count}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Tickets}"
                              Visibility="{Binding Loading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,10,0,0"
                                    Style="{StaticResource PressScaleBorder}"
                                    MouseLeftButtonUp="OnTicketClick" Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource ManropeSemiBoldFamily}"
                                                       FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Background="{DynamicResource DangerBrush}" CornerRadius="9"
                                                    MinWidth="18" Height="18" Margin="6,0,0,0"
                                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding UnreadCount}" FontSize="10" FontFamily="{StaticResource ManropeExtraBoldFamily}"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding LastMessage}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,6"
                                                   Visibility="{Binding LastMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontFamily="{StaticResource ManropeSemiBoldFamily}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TealDeepBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text=" · " FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                                       Visibility="{Binding DateLabel, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding DateLabel}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="›" FontSize="18" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ProgressBar Width="20" Height="20" IsIndeterminate="True" Foreground="{DynamicResource TealDeepBrush}"
                             HorizontalAlignment="Center" Margin="0,14,0,0"
                             Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="Показать ещё" Padding="14,7" Margin="0,14,0,0"
                        HorizontalAlignment="Center" Command="{Binding LoadMoreCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanLoadMore}" Value="True"/>
                                        <Condition Binding="{Binding LoadingMore}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

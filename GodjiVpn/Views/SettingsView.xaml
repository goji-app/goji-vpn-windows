<UserControl x:Class="GodjiVpn.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="clr-namespace:GodjiVpn.Utils">
    <Grid Background="{DynamicResource BgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,18,18,10">
            <StackPanel>

                <TextBlock Text="Настройки" Style="{StaticResource Headline}" FontSize="26" Margin="0,0,0,16"/>

                <!-- Внешний вид: Светлая/Тёмная/Системная (см. ThemeMode) — была бинарным
                     переключателем, "Системная" живо следит за темой Windows, пока приложение
                     открыто (см. ThemeService.OnUserPreferenceChanged). -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1.5" CornerRadius="24" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Тема оформления" FontFamily="{StaticResource ManropeSemiBoldFamily}" FontSize="14" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="16" Padding="5">
                            <ItemsControl ItemsSource="{Binding ThemeModes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="2" Padding="14,8"
                                                Command="{Binding DataContext.SelectThemeModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PressScaleButtonBase}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource ManropeSemiBoldFamily}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- О приложении -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1.5" CornerRadius="24" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="О приложении" FontFamily="{StaticResource ManropeSemiBoldFamily}" FontSize="14" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Версия" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontFamily="{StaticResource ManropeSemiBoldFamily}" FontSize="12.5"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Hwid}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Копировать HWID" Style="{StaticResource LinkButton}" FontSize="11"
                                    Command="{Binding CopyHwidCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Обновления — проверка через GitHub Releases (api.github.com), скачивание и
                     запуск установщика прямо из приложения (см. Services/UpdateService.cs). -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1.5" CornerRadius="24" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Обновления" FontFamily="{StaticResource ManropeSemiBoldFamily}" FontSize="14" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Проверить" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11"
                                    Command="{Binding CheckForUpdateCommand}"
                                    Visibility="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>

                        <TextBlock Text="Проверяем…" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"
                                   Visibility="{Binding IsCheckingUpdate, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding UpdateCheckMessage}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding UpdateCheckMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <StackPanel Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Background="{DynamicResource TealTintBrush}" BorderBrush="{DynamicResource TealTintBorderBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource ManropeExtraBoldFamily}" FontSize="12.5" Foreground="{DynamicResource TealDeepBrush}">
                                        <Run Text="Доступна версия "/><Run Text="{Binding AvailableUpdate.VersionLabel, Mode=OneWay}"/>
                                    </TextBlock>
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,8,0,0" MaxHeight="220">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <RichTextBox utils:RichTextBoxBehavior.AttachedDocument="{Binding UpdateChangelogDocument}"
                                                         IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Background="Transparent"
                                                         Padding="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                                        </ScrollViewer>
                                    </Border>

                                    <ProgressBar Height="6" Margin="0,10,0,0" Minimum="0" Maximum="1" Value="{Binding DownloadProgress}"
                                                 Foreground="{DynamicResource TealBrush}" Background="{DynamicResource ChipBrush}" BorderThickness="0"
                                                 Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <Button Content="Скачать и установить" Style="{StaticResource InkButton}" Margin="0,10,0,0"
                                            HorizontalAlignment="Stretch" Command="{Binding DownloadAndInstallUpdateCommand}"
                                            Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Проверка серверов -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1.5" CornerRadius="24" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Проверка серверов" FontFamily="{StaticResource ManropeSemiBoldFamily}" FontSize="14" Margin="0,0,0,10"/>

                        <TextBlock Text="Способ пинга" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontFamily="{StaticResource ManropeSemiBoldFamily}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="16" Padding="5" Margin="0,0,0,12">
                            <ItemsControl ItemsSource="{Binding PingMethods}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="2" Padding="8,8"
                                                Command="{Binding DataContext.SelectPingMethodCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PressScaleButtonBase}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <!-- Явный TextBlock со своим Foreground, а не неявная генерация из
                                                 Content="{Binding Label}" (та наследует Foreground кнопки через
                                                 property-value-inheritance — на практике для этих конкретных
                                                 чипов почему-то не подхватывала DynamicResource-подмену цвета
                                                 при выборе, текст становился нечитаемым). -->
                                            <TextBlock Text="{Binding Label}" FontSize="10" FontFamily="{StaticResource ManropeSemiBoldFamily}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="URL для теста (через прокси)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontFamily="{StaticResource ManropeSemiBoldFamily}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding PingTestUrl, UpdateSourceTrigger=PropertyChanged}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Логи -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1.5" CornerRadius="24" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Журнал" FontFamily="{StaticResource ManropeSemiBoldFamily}" FontSize="14" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="⟳" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12"
                                    Command="{Binding RefreshLogCommand}"/>
                        </Grid>

                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="16" Padding="5" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding LogFiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="2" Padding="8,8"
                                                Command="{Binding DataContext.SelectLogFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PressScaleButtonBase}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding Label}" FontSize="10.5" FontFamily="{StaticResource ManropeSemiBoldFamily}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="1" Height="260">
                            <TextBox Text="{Binding LogContent, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="10.5" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Button Content="Копировать" Style="{StaticResource SecondaryButton}" Padding="12,7" FontSize="11.5"
                                    Command="{Binding CopyLogCommand}" Margin="0,0,8,0"/>
                            <Button Content="Открыть папку" Style="{StaticResource SecondaryButton}" Padding="12,7" FontSize="11.5"
                                    Command="{Binding OpenLogsFolderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Content="Выйти из аккаунта" Style="{StaticResource LinkButton}" Foreground="{DynamicResource DangerBrush}"
                        HorizontalAlignment="Center" Command="{Binding LogoutCommand}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<Window x:Class="GodjiVpn.Views.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поддержка" Height="720" Width="460"
        MinHeight="480" MinWidth="360"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Closing="OnClosing">
    <!-- Аналог MainWindow — какая View показывается, решают DataTemplate'ы в App.xaml по типу
         CurrentViewModel (SupportShellViewModel переключает список/создание/чат/FAQ). Каждый
         экран сам рисует свою шапку с "← Назад" — здесь общего заголовка нет, как и в Android,
         где у каждого экрана своя TopAppBar. -->
    <ContentControl Content="{Binding CurrentViewModel}"/>
</Window>
